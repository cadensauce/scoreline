{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scoreline",
  "version": "1.0.0",
  "identifier": "io.github.cadensauce.scoreline",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Scoreline",
        "url": "https://cadensauce.github.io/scoreline/",
        "width": 1200,
        "height": 820,
        "minWidth": 380,
        "minHeight": 600,
        "backgroundColor": "#0b0e13"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Scoreline",
    "shortDescription": "Live sports scores",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
