rules_version = '2';
// Scoreline security rules. Paste into Firebase console -> Firestore Database -> Rules -> Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    // Two-step sign-in: if you turned it on (twoStep/{uid} exists), a device only counts as signed in after it
    // entered the emailed code; the push worker then signs it in with a token marked ts = true.
    function verified() { return !exists(/databases/$(database)/documents/twoStep/$(request.auth.uid)) || request.auth.token.ts == true; }
    function member() { return signedIn() && verified(); }
    // Site switch: in read-only or offline mode, new messages, friend requests and reactions are paused (the owner can still act).
    function siteOpen() { return !exists(/databases/$(database)/documents/public/site) || get(/databases/$(database)/documents/public/site).data.mode == 'on' || isOwner(); }
    function friends(a, b) {
      return (exists(/databases/$(database)/documents/requests/$(a + '_' + b)) && get(/databases/$(database)/documents/requests/$(a + '_' + b)).data.status == 'accepted')
          || (exists(/databases/$(database)/documents/requests/$(b + '_' + a)) && get(/databases/$(database)/documents/requests/$(b + '_' + a)).data.status == 'accepted');
    }

    // Private settings: favourite teams, alert settings. Only the owner can see or change them.
    match /users/{uid} {
      allow read, delete: if member() && me() == uid;
      // Only the settings the app saves, at sensible sizes (old extra fields are left alone on update).
      allow create: if member() && me() == uid && request.resource.data.keys().hasOnly(['favs', 'favNames', 'alertPrefs', 'updatedAt', 'heldTitle', 'heldBanner', 'heldDeco']) && settingsOk();
      allow update: if member() && me() == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['favs', 'favNames', 'alertPrefs', 'updatedAt', 'heldTitle', 'heldBanner', 'heldDeco']) && settingsOk();
    }
    function settingsOk() {
      return (!('favs' in request.resource.data) || (request.resource.data.favs is list && request.resource.data.favs.size() <= 200))
        && (!('favNames' in request.resource.data) || (request.resource.data.favNames is map && request.resource.data.favNames.size() <= 400))
        && (!('alertPrefs' in request.resource.data) || (request.resource.data.alertPrefs is map && request.resource.data.alertPrefs.size() <= 80))
        && (!('heldTitle' in request.resource.data) || (request.resource.data.heldTitle is string && request.resource.data.heldTitle.size() <= 40))
        && (!('heldBanner' in request.resource.data) || (request.resource.data.heldBanner is string && request.resource.data.heldBanner.size() <= 40));
    }

    // Public profile: just the username, so friends can find each other.
    match /profiles/{uid} {
      allow read: if member();
      allow create, update: if member() && me() == uid
        && request.resource.data.keys().hasOnly(['username', 'createdAt'])
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[a-z0-9_]{3,20}$');
      allow delete: if member() && me() == uid;
    }

    // Profile: photo (a small JPEG made on the device), display name, bio, a free theme, favourite sports, teams and
    // players, plus Shop extras (title, banner, picture decoration). Visible to you, and to friends when you choose "Friends".
    match /cards/{uid} {
      allow read: if member() && (me() == uid || (resource.data.show == 'friends' && friends(me(), uid)));
      allow create, update: if member() && me() == uid
        && request.resource.data.keys().hasOnly(['avatar', 'bio', 'teams', 'show', 'updatedAt', 'title', 'banner', 'deco', 'name', 'theme', 'sports', 'favTeams', 'favPlayers'])
        // Shop extras can only be shown if you own them, and only while you've agreed to the Terms (withdrawing freezes them).
        && ((request.resource.data.get('title', '') == '' && request.resource.data.get('banner', '') == '' && request.resource.data.get('deco', '') == '')
          || (exists(/databases/$(database)/documents/ages/$(uid)) && get(/databases/$(database)/documents/ages/$(uid)).data.is13plus == true))
        && (!('title' in request.resource.data) || request.resource.data.title == '' || exists(/databases/$(database)/documents/inventory/$(uid)/items/$(request.resource.data.title)))
        && (!('banner' in request.resource.data) || request.resource.data.banner == '' || exists(/databases/$(database)/documents/inventory/$(uid)/items/$(request.resource.data.banner)))
        && (!('deco' in request.resource.data) || request.resource.data.deco == '' || exists(/databases/$(database)/documents/inventory/$(uid)/items/$(request.resource.data.deco)))
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 30))
        && (!('theme' in request.resource.data) || request.resource.data.theme in ['', 'plain', 'night', 'field', 'court', 'diamond', 'track'])
        && (!('sports' in request.resource.data) || (request.resource.data.sports is list && request.resource.data.sports.size() <= 5 && request.resource.data.sports.hasOnly(['nfl', 'cfb', 'nba', 'mlb', 'f1'])))
        && (!('favTeams' in request.resource.data) || (request.resource.data.favTeams is list && request.resource.data.favTeams.size() <= 12))
        && (!('favPlayers' in request.resource.data) || (request.resource.data.favPlayers is list && request.resource.data.favPlayers.size() <= 20))
        && request.resource.data.avatar is string && request.resource.data.avatar.size() <= 60000
        && (request.resource.data.avatar == '' || request.resource.data.avatar.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$'))
        && request.resource.data.bio is string && request.resource.data.bio.size() <= 160
        && request.resource.data.teams is list && request.resource.data.teams.size() <= 30
        && request.resource.data.show in ['friends', 'me'];
      allow delete: if member() && me() == uid;
    }

    // Roles (tags + permissions). The Owner is set only by the worker from a list in its code. Only the Owner can give
    // or take away the other roles (Dev, Mod, Beta Tester), never their own and never another Owner's.
    function roleOf(uid) { return exists(/databases/$(database)/documents/roles/$(uid)) ? get(/databases/$(database)/documents/roles/$(uid)).data.role : ''; }
    function isOwner() { return roleOf(me()) == 'owner'; }
    function isMod() { return roleOf(me()) in ['owner', 'mod']; }
    match /roles/{uid} {
      allow read: if member();
      allow create, update: if member() && isOwner() && uid != me()
        && (resource == null || resource.data.role != 'owner')
        && request.resource.data.keys().hasOnly(['role', 'by', 'at'])
        && request.resource.data.role in ['dev', 'mod', 'tester']
        && request.resource.data.by == me() && request.resource.data.at == request.time;
      allow delete: if member() && isOwner() && uid != me() && resource.data.role != 'owner';
    }

    // Profile stats (Picks record, Fantasy, leagues, friends). Only the worker writes them, so nobody can fake theirs.
    // Seen by the same people as the profile.
    match /pstats/{uid} {
      allow get: if member() && (me() == uid || (friends(me(), uid)
        && get(/databases/$(database)/documents/cards/$(uid)).data.get('show', 'friends') == 'friends'));
      allow write: if false;
    }

    // Username -> uid lookup. First come, first served; you can only claim names for yourself.
    match /usernames/{name} {
      allow read: if member();
      allow create: if member() && request.resource.data.uid == me() && name.matches('^[a-z0-9_]{3,20}$');
      allow delete: if member() && resource.data.uid == me();
    }

    // Friend requests. Document id is "<from>_<to>".
    match /requests/{id} {
      allow read: if member() && (resource.data.from == me() || resource.data.to == me());
      allow create: if member() && siteOpen() && request.resource.data.from == me()
        && id == me() + '_' + request.resource.data.to
        && request.resource.data.keys().hasOnly(['from', 'to', 'status', 'at'])
        && request.resource.data.to is string && request.resource.data.to.size() <= 128
        && request.resource.data.status == 'pending'
        && request.resource.data.to != me();
      allow update: if member() && resource.data.to == me()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'accepted';
      allow delete: if member() && (resource.data.from == me() || resource.data.to == me());
    }

    // Public info the site needs, like the push worker's public key. Read-only for everyone.
    match /public/{doc} {
      allow read: if true;
      allow write: if false;
    }
    // The site switch (owner only): normal, read-only or offline, with a short message. Everyone can read it.
    match /public/site {
      allow read: if true;
      allow write: if member() && isOwner() && request.resource.data.keys().hasOnly(['mode', 'msg', 'at', 'by'])
        && request.resource.data.mode in ['on', 'readonly', 'offline'] && request.resource.data.msg is string && request.resource.data.msg.size() <= 200
        && request.resource.data.by == me() && request.resource.data.at == request.time;
    }

    // Push alert subscriptions (phones with Scoreline on the home screen). The id is a hash of the
    // phone's private push address, so only that phone can update or remove its own entry.
    // Nobody can read them from the app; only the push worker (server key) can.
    match /pushSubs/{id} {
      allow read: if false;
      allow create, update: if id.matches('^[0-9a-f]{64}$')
        && request.resource.data.keys().hasOnly(['endpoint', 'p256dh', 'auth', 'favs', 'prefs', 'updatedAt'])
        && request.resource.data.endpoint is string && request.resource.data.endpoint.matches('^https://.*')
        && request.resource.data.favs is list && request.resource.data.favs.size() <= 200
        && request.resource.data.endpoint.size() <= 1000
        && (!('p256dh' in request.resource.data) || (request.resource.data.p256dh is string && request.resource.data.p256dh.size() <= 200))
        && (!('auth' in request.resource.data) || (request.resource.data.auth is string && request.resource.data.auth.size() <= 100))
        && (!('prefs' in request.resource.data) || (request.resource.data.prefs is map && request.resource.data.prefs.size() <= 80));
      allow delete: if id.matches('^[0-9a-f]{64}$');
    }

    // One-time codes that move your sign-in from the website to a newly installed app.
    // You create a code for your own account only; the push worker (server key) adds a one-time sign-in pass;
    // anyone holding the exact code can read that one document for 10 minutes (no listing). You delete it after use.
    match /signinCodes/{code} {
      allow create: if member() && code.matches('^[A-HJ-NP-Z2-9]{8}$')
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == me()
        && request.resource.data.createdAt == request.time;
      allow get: if code.matches('^[A-HJ-NP-Z2-9]{8}$') && request.time < resource.data.createdAt + duration.value(10, 'm');
      allow list, update: if false;
      allow delete: if member() && resource.data.uid == me();
    }

    // ---- Two-step sign-in (emailed codes) ----
    // twoStep/{uid} exists when you turned it on. Only the push worker creates it (after you entered a code);
    // you can turn it off from a verified device.
    match /twoStep/{uid} {
      allow get: if signedIn() && me() == uid;
      allow delete: if signedIn() && me() == uid && request.auth.token.ts == true;
      allow list, create, update: if false;
    }
    // Ask the push worker to email you a code (at most once a minute).
    match /otpRequests/{uid} {
      allow create: if signedIn() && me() == uid && request.resource.data.keys().hasOnly(['createdAt', 'purpose'])
        && request.resource.data.createdAt == request.time && request.resource.data.purpose in ['signin', 'enable'];
      allow update: if signedIn() && me() == uid && request.resource.data.keys().hasOnly(['createdAt', 'purpose'])
        && request.resource.data.createdAt == request.time && request.resource.data.purpose in ['signin', 'enable']
        && request.time > resource.data.createdAt + duration.value(60, 's');
      allow read, delete: if false;
    }
    // The code you typed; only the push worker reads it (it allows 5 tries per code).
    match /otpAttempts/{uid} {
      allow create, update: if signedIn() && me() == uid && request.resource.data.keys().hasOnly(['code', 'createdAt'])
        && request.resource.data.code is string && request.resource.data.code.size() == 6
        && request.resource.data.createdAt == request.time;
      allow read, delete: if false;
    }
    // The worker's answer: a one-time verified sign-in pass, or why the code didn't work.
    match /otpResults/{uid} {
      allow get, delete: if signedIn() && me() == uid;
      allow list, create, update: if false;
    }
    // Anonymous alert-setup health reports: a short code and the app version, keyed by the same random
    // device id as pushSubs. Nothing personal. Only the push worker can read them.
    match /diag/{id} {
      allow read: if false;
      allow create, update: if id.matches('^[0-9a-f]{64}$')
        && request.resource.data.keys().hasOnly(['code', 'app', 'at'])
        && request.resource.data.code is string && request.resource.data.code.size() <= 120
        && request.resource.data.app is string && request.resource.data.app.size() <= 20;
      allow delete: if false;
    }


    // ---- Picks and Marks (Phase 5) ----
    // Terms agreement: "I agree" to the Terms (which include being 13 or older). Can't be edited; can be withdrawn and given again.
    match /ages/{uid} {
      allow get: if member() && me() == uid;
      allow create: if member() && me() == uid
        && request.resource.data.keys().hasOnly(['is13plus', 'at'])
        && request.resource.data.is13plus is bool && request.resource.data.at == request.time;
      // You can withdraw (delete it) any time; Marks stop until you agree again.
      allow delete: if member() && me() == uid;
      allow list, update: if false;
    }
    function lockOf(gameId) { return get(/databases/$(database)/documents/games/$(gameId)).data.lockAt; }
    // Games open for picks: written only by the push worker (kickoff time = lock time, Upset bonus, result).
    match /games/{id} {
      allow read: if true;
      allow write: if false;
    }
    // Your pick for one game. Anyone signed in can pick (just for fun); only people who agreed to the Terms earn Marks.
    // Free, stakes nothing. Locks at kickoff by the server's clock (not the phone's).
    // Only the push worker marks it won/lost and pays Marks.
    match /picks/{id} {
      allow read: if member() && resource.data.uid == me();
      allow create, update: if member()
        && id == me() + '_' + request.resource.data.gameId
        && request.resource.data.keys().hasOnly(['uid', 'gameId', 'side', 'updatedAt'])
        && request.resource.data.uid == me()
        && request.resource.data.gameId is string
        && request.resource.data.side in ['home', 'away']
        && request.resource.data.updatedAt == request.time
        && request.time < lockOf(request.resource.data.gameId);
      allow delete: if member() && resource.data.uid == me() && request.time < lockOf(resource.data.gameId);
    }
    // Marks balance and its history: you can read your own; only the push worker writes them.
    // ---- Shop: titles and banners you unlock with Marks (in-app only, no real-world value) ----
    function teen() {
      return exists(/databases/$(database)/documents/ages/$(me()))
        && get(/databases/$(database)/documents/ages/$(me())).data.is13plus == true;
    }
    function priceOf(item) { return get(/databases/$(database)/documents/shopItems/$(item)).data.price; }
    function walletPath(uid) { return /databases/$(database)/documents/wallets/$(uid); }
    // ---- Fantasy: Free Fantasy (no currency) and Marks Fantasy (Terms agreement / 13+ only; free to enter, earns Marks,
    // which are NOT real money). Contests and boards are written only by the push worker.
    match /fcontests/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /fboard/{id} {
      allow read: if true;
      allow write: if false;
    }
    function contestOf(cid) { return get(/databases/$(database)/documents/fcontests/$(cid)).data; }
    // Your lineup for one contest in one mode: fentries/{contestId}_{mode}_{uid}. Locks at the contest's first game
    // (server clock). Only players from that contest, no repeats, up to 10 spots. Marks mode needs the Terms agreement.
    // Friends can see each other's lineups and scores; nobody else can.
    match /fentries/{id} {
      allow get: if member() && (resource.data.uid == me() || friends(me(), resource.data.uid));
      allow list: if member() && resource.data.uid == me();
      allow create, update: if member()
        && request.resource.data.keys().hasOnly(['uid', 'contestId', 'mode', 'lineup', 'updatedAt'])
        && request.resource.data.uid == me()
        && request.resource.data.mode in ['free', 'marks']
        && (request.resource.data.mode == 'free' || teen())
        && request.resource.data.contestId is string
        && id == request.resource.data.contestId + '_' + request.resource.data.mode + '_' + me()
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lineup is map && request.resource.data.lineup.size() <= 10
        && request.resource.data.lineup.values().toSet().size() == request.resource.data.lineup.size()
        && exists(/databases/$(database)/documents/fcontests/$(request.resource.data.contestId))
        && request.time < contestOf(request.resource.data.contestId).lockAt
        && contestOf(request.resource.data.contestId).pool.keys().hasAll(request.resource.data.lineup.values());
      allow delete: if member() && resource.data.uid == me() && request.time < contestOf(resource.data.contestId).lockAt;
    }

    // ---- Season leagues with friends: create, invite friends, join, a snake draft, then weekly starters. ----
    // The worker publishes fpool/{lg} (draftable players) and writes the scores (locked, weeks, totals, scored).
    match /fpool/{lg} {
      allow read: if true;
      allow write: if false;
    }
    function rosterFor(lg) { return lg == 'nba' ? 7 : lg == 'mlb' ? 6 : lg == 'f1' ? 3 : 8; }
    function maxFor(lg) { return lg == 'f1' ? 7 : 12; }
    function slotKeys(lg) {
      return lg == 'nba' ? ['g1', 'g2', 'f1', 'f2', 'c'] : lg == 'mlb' ? ['h1', 'h2', 'h3', 'p'] : lg == 'f1' ? ['d1', 'd2', 'd3'] : ['qb', 'rb1', 'rb2', 'wr1', 'wr2', 'te'];
    }
    // Whose turn it is (snake order: 1-2-3, 3-2-1, ...).
    function drafter(d) {
      let n = d.order.size();
      let r = math.floor(d.pick / n);
      let p = d.pick % n;
      return d.order[r % 2 == 0 ? p : n - 1 - p];
    }
    match /leagues/{id} {
      allow read: if member() && (me() in resource.data.members || me() in resource.data.invites);
      // Create: you're the owner and the only member; invite up to 11 people (they must be your friends to join).
      allow create: if member()
        && request.resource.data.keys().hasOnly(['name', 'lg', 'mode', 'owner', 'members', 'invites', 'status', 'rosterSize', 'createdAt', 'updatedAt'])
        && request.resource.data.owner == me() && request.resource.data.members == [me()]
        && request.resource.data.status == 'forming'
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 40
        && request.resource.data.lg in ['nfl', 'cfb', 'nba', 'mlb', 'f1']
        && request.resource.data.mode in ['free', 'marks'] && (request.resource.data.mode == 'free' || teen())
        && request.resource.data.invites is list && request.resource.data.invites.size() <= 11 && !(me() in request.resource.data.invites)
        && request.resource.data.rosterSize == rosterFor(request.resource.data.lg)
        && request.resource.data.createdAt == request.time;
      // Owner changes who's invited (before the draft).
      allow update: if member() && resource.data.status == 'forming' && me() == resource.data.owner
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['invites', 'updatedAt'])
        && request.resource.data.invites is list && request.resource.data.invites.size() <= 11;
      // Join: you were invited, you're friends with the owner, there's room (Marks leagues: Terms agreement).
      allow update: if member() && resource.data.status == 'forming' && me() in resource.data.invites && !(me() in resource.data.members)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'invites', 'updatedAt'])
        && request.resource.data.members == resource.data.members.concat([me()])
        && request.resource.data.invites == resource.data.invites.removeAll([me()])
        && request.resource.data.members.size() <= maxFor(resource.data.lg)
        && friends(me(), resource.data.owner)
        && (resource.data.mode == 'free' || teen());
      // Decline an invite, or leave before the draft (the owner can't leave; they delete the league instead).
      allow update: if member() && resource.data.status == 'forming' && me() != resource.data.owner
        && (me() in resource.data.invites || me() in resource.data.members)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'invites', 'updatedAt'])
        && request.resource.data.members == resource.data.members.removeAll([me()])
        && request.resource.data.invites == resource.data.invites.removeAll([me()]);
      // Owner starts the draft: a draft order made of exactly the members.
      allow update: if member() && resource.data.status == 'forming' && me() == resource.data.owner && resource.data.members.size() >= 2
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'order', 'pick', 'taken', 'invites', 'updatedAt'])
        && request.resource.data.status == 'drafting' && request.resource.data.pick == 0 && request.resource.data.taken == {}
        && request.resource.data.invites == []
        && request.resource.data.order.size() == resource.data.members.size()
        && request.resource.data.order.toSet() == resource.data.members.toSet();
      // A draft pick: by whoever's turn it is (or the owner, for them). One player nobody has, from the player list.
      // The last pick ends the draft and starts the season.
      allow update: if member() && resource.data.status == 'drafting'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pick', 'taken', 'last', 'status', 'startedAt', 'updatedAt'])
        && request.resource.data.pick == resource.data.pick + 1
        && resource.data.pick < resource.data.order.size() * resource.data.rosterSize
        && request.resource.data.last.keys().hasOnly(['uid', 'pid'])
        && request.resource.data.last.uid == drafter(resource.data)
        && (me() == request.resource.data.last.uid || me() == resource.data.owner)
        && request.resource.data.last.pid is string && !(request.resource.data.last.pid in resource.data.taken)
        && request.resource.data.taken.diff(resource.data.taken).affectedKeys() == [request.resource.data.last.pid].toSet()
        && request.resource.data.taken[request.resource.data.last.pid] == request.resource.data.last.uid
        && get(/databases/$(database)/documents/fpool/$(resource.data.lg)).data.players.keys().hasAny([request.resource.data.last.pid])
        && (request.resource.data.pick == resource.data.order.size() * resource.data.rosterSize
          ? (request.resource.data.status == 'active' && request.resource.data.startedAt == request.time)
          : (request.resource.data.status == 'drafting' && !('startedAt' in request.resource.data)));
      allow delete: if member() && me() == resource.data.owner && resource.data.status in ['forming', 'drafting'];
    }
    // Your starters in a league: lstarts/{leagueId}_{uid}. Only players you drafted, only the sport's spots.
    // The worker copies them into the league when each week locks, so changes count from the next week.
    function league(lid) { return get(/databases/$(database)/documents/leagues/$(lid)).data; }
    function mineAt(t, lu, k) { return !(k in lu) || (lu[k] in t && t[lu[k]] == me()); }
    match /lstarts/{id} {
      allow get: if member() && me() in league(resource.data.leagueId).members;
      allow create, update: if member()
        && request.resource.data.keys().hasOnly(['uid', 'leagueId', 'lineup', 'updatedAt'])
        && request.resource.data.uid == me() && request.resource.data.leagueId is string
        && id == request.resource.data.leagueId + '_' + me()
        && request.resource.data.updatedAt == request.time
        && league(request.resource.data.leagueId).status == 'active' && me() in league(request.resource.data.leagueId).members
        && request.resource.data.lineup is map
        && request.resource.data.lineup.keys().hasOnly(slotKeys(league(request.resource.data.leagueId).lg))
        && request.resource.data.lineup.values().toSet().size() == request.resource.data.lineup.size()
        && mineAt(league(request.resource.data.leagueId).taken, request.resource.data.lineup, 'qb')
        && mineAt(league(request.resource.data.leagueId).taken, request.resource.data.lineup, 'rb1')
        && mineAt(league(request.resource.data.leagueId).taken, request.resource.data.lineup, 'rb2')
        && mineAt(league(request.resource.data.leagueId).taken, request.resource.data.lineup, 'wr1')
        && mineAt(league(request.resource.data.leagueId).taken, request.resource.data.lineup, 'wr2')
        && mineAt(league(request.resource.data.leagueId).taken, request.resource.data.lineup, 'te')
        && mineAt(league(request.resource.data.leagueId).taken, request.resource.data.lineup, 'g1')
        && mineAt(league(request.resource.data.leagueId).taken, request.resource.data.lineup, 'g2')
        && mineAt(league(request.resource.data.leagueId).taken, request.resource.data.lineup, 'f1')
        && mineAt(league(request.resource.data.leagueId).taken, request.resource.data.lineup, 'f2')
        && mineAt(league(request.resource.data.leagueId).taken, request.resource.data.lineup, 'c')
        && mineAt(league(request.resource.data.leagueId).taken, request.resource.data.lineup, 'h1')
        && mineAt(league(request.resource.data.leagueId).taken, request.resource.data.lineup, 'h2')
        && mineAt(league(request.resource.data.leagueId).taken, request.resource.data.lineup, 'h3')
        && mineAt(league(request.resource.data.leagueId).taken, request.resource.data.lineup, 'p')
        && mineAt(league(request.resource.data.leagueId).taken, request.resource.data.lineup, 'd1')
        && mineAt(league(request.resource.data.leagueId).taken, request.resource.data.lineup, 'd2')
        && mineAt(league(request.resource.data.leagueId).taken, request.resource.data.lineup, 'd3');
      allow delete: if member() && resource.data.uid == me();
    }

    // The list of items and prices: written only by the push worker.
    match /shopItems/{item} {
      allow read: if true;
      allow write: if false;
    }
    // What you own. Buying is one batch: this item + the Marks taken off your balance + a ledger entry.
    // The rules check the price, that you had enough Marks, and that you can't buy the same item twice.
    match /inventory/{uid}/items/{item} {
      allow read: if member() && me() == uid;
      allow create: if member() && me() == uid && teen()
        && request.resource.data.keys().hasOnly(['price', 'at'])
        && request.resource.data.price == priceOf(item)
        && request.resource.data.at == request.time
        && exists(walletPath(uid))
        && getAfter(walletPath(uid)).data.balance == get(walletPath(uid)).data.balance - priceOf(item)
        && getAfter(walletPath(uid)).data.balance >= 0
        && existsAfter(/databases/$(database)/documents/ledger/$(uid)/entries/$('shop_' + item));
      allow update, delete: if false;
    }
    // ---- Dev accounts: can give Marks (1 to 10,000 at a time) to any account that agreed to the Terms (13+), themselves
    // included. Who is a dev is set by hand in the Firebase console: a devs/<username> document (for example devs/cadenbinglefry).
    // The rules check that username really belongs to whoever is giving, so nobody can make themselves one.
    // Every gift is one batch: a ledger entry grant_<id> (amount, by whom) + the same amount added to the wallet.
    function devOk(name) {
      return name is string && name.matches('^[a-z0-9_]{3,20}$')
        && exists(/databases/$(database)/documents/devs/$(name))
        && get(/databases/$(database)/documents/usernames/$(name)).data.uid == me();
    }
    function teenUid(uid) {
      return exists(/databases/$(database)/documents/ages/$(uid))
        && get(/databases/$(database)/documents/ages/$(uid)).data.is13plus == true;
    }
    function grantOf(uid, entry) { return getAfter(/databases/$(database)/documents/ledger/$(uid)/entries/$(entry)).data; }
    match /devs/{name} {
      allow get: if member() && get(/databases/$(database)/documents/usernames/$(name)).data.uid == me();
      allow list, write: if false;
    }
    match /wallets/{uid} {
      allow read: if member() && me() == uid;
      // You can only lower your own balance (when buying; the item rules check the amount). Only the worker adds Marks,
      // apart from a dev's gift, which must match its ledger entry exactly.
      allow update: if member() && me() == uid && teen()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balance', 'updatedAt'])
        && request.resource.data.balance < resource.data.balance && request.resource.data.balance >= 0;
      allow update: if member() && teenUid(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balance', 'updatedAt', 'lastGrant'])
        && request.resource.data.lastGrant is string && request.resource.data.lastGrant != resource.data.get('lastGrant', '')
        && devOk(grantOf(uid, request.resource.data.lastGrant).dev)
        && request.resource.data.balance == resource.data.balance + grantOf(uid, request.resource.data.lastGrant).amount;
      allow create: if member() && teenUid(uid)
        && request.resource.data.keys().hasOnly(['balance', 'updatedAt', 'lastGrant'])
        && request.resource.data.lastGrant is string
        && devOk(grantOf(uid, request.resource.data.lastGrant).dev)
        && request.resource.data.balance == grantOf(uid, request.resource.data.lastGrant).amount;
      allow delete: if false;
    }
    match /ledger/{uid}/entries/{entry} {
      allow read: if member() && me() == uid;
      allow create: if member() && devOk(request.resource.data.dev) && teenUid(uid) && entry.matches('grant_[A-Za-z0-9]{8,40}')
        && request.resource.data.keys().hasOnly(['amount', 'reason', 'by', 'dev', 'createdAt'])
        && request.resource.data.reason == 'dev' && request.resource.data.by == me()
        && request.resource.data.amount is int && request.resource.data.amount >= 1 && request.resource.data.amount <= 10000
        && request.resource.data.createdAt == request.time
        && getAfter(walletPath(uid)).data.lastGrant == entry;
      // A purchase writes its own entry (shop_<item>), matching the item's price. Everything else is the worker's.
      allow create: if member() && me() == uid && teen() && entry.matches('shop_[a-z0-9_]{1,40}')
        && request.resource.data.keys().hasOnly(['amount', 'reason', 'refId', 'createdAt'])
        && request.resource.data.reason == 'shop' && entry == 'shop_' + request.resource.data.refId
        && request.resource.data.amount == -priceOf(request.resource.data.refId)
        && request.resource.data.createdAt == request.time
        && existsAfter(/databases/$(database)/documents/inventory/$(uid)/items/$(request.resource.data.refId));
      allow update, delete: if false;
    }
    // Chats. Direct chats (id "a_b", the two uids sorted): only between friends.
    // Group chats (id "g_..."): the owner invites people; each invited person accepts or declines, so nobody is put in
    // a group without saying yes. Only members read messages. Sending needs the chat rules agreed (chatOk/{uid});
    // in a direct chat you must still be friends and not blocked by the other person.
    function lastOk(d) {
      return !('last' in d) || (d.last is map && d.last.keys().hasOnly(['from', 'text', 'at']) && d.last.from == me()
        && d.last.text is string && d.last.text.size() <= 120 && d.last.at == request.time);
    }
    function groupName(n) { return n is string && n.size() >= 1 && n.size() <= 40; }
    function isGroup(d) { return d.get('group', false) == true; }
    match /chats/{chatId} {
      allow read: if member() && (me() in resource.data.members || me() in resource.data.get('invited', []));
      allow create: if member() && !chatId.matches('^g_.*')
        && me() in request.resource.data.members
        && request.resource.data.members.size() == 2
        && chatId == request.resource.data.members[0] + '_' + request.resource.data.members[1]
        && friends(request.resource.data.members[0], request.resource.data.members[1])
        && request.resource.data.keys().hasOnly(['members', 'updatedAt', 'last']) && lastOk(request.resource.data);
      allow create: if member() && chatId.matches('^g_[A-Za-z0-9]{8,32}$')
        && request.resource.data.keys().hasOnly(['members', 'updatedAt', 'name', 'owner', 'invited', 'last', 'group'])
        && request.resource.data.group == true && request.resource.data.owner == me()
        && request.resource.data.members == [me()]
        && request.resource.data.invited is list && request.resource.data.invited.size() >= 1 && request.resource.data.invited.size() <= 9
        && !(me() in request.resource.data.invited)
        && groupName(request.resource.data.name) && lastOk(request.resource.data);
      // Any member: the latest-message preview and time (sending). Nothing else changes.
      allow update: if member() && me() in resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt', 'last']) && lastOk(request.resource.data);
      // Leave a group.
      allow update: if member() && isGroup(resource.data) && me() in resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'updatedAt'])
        && request.resource.data.members.toSet() == resource.data.members.toSet().difference([me()].toSet());
      // Accept (join) or decline a group invite.
      allow update: if member() && isGroup(resource.data) && me() in resource.data.get('invited', [])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'invited', 'updatedAt'])
        && request.resource.data.invited.toSet() == resource.data.invited.toSet().difference([me()].toSet())
        && (request.resource.data.members == resource.data.members
            || request.resource.data.members.toSet() == resource.data.members.toSet().union([me()].toSet()))
        && request.resource.data.members.size() <= 10;
      // Owner: rename, invite more people, remove people (never add them directly).
      allow update: if member() && isGroup(resource.data) && resource.data.owner == me() && me() in resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'invited', 'members', 'updatedAt'])
        && groupName(request.resource.data.name)
        && me() in request.resource.data.members
        && resource.data.members.toSet().hasAll(request.resource.data.members.toSet())
        && request.resource.data.invited is list && request.resource.data.invited.size() <= 9
        && request.resource.data.members.size() + request.resource.data.invited.size() <= 10;

      match /messages/{msg} {
        function chat() { return get(/databases/$(database)/documents/chats/$(chatId)).data; }
        function other() { return chat().members[0] == me() ? chat().members[1] : chat().members[0]; }
        function shareOk(s) {
          return s is map && s.keys().hasOnly(['k', 'lg', 'id', 't', 's'])
            && s.k in ['game', 'player', 'team', 'driver', 'fantasy']
            && s.id is string && s.id.size() >= 1 && s.id.size() <= 40
            && s.t is string && s.t.size() <= 80
            && (!('lg' in s) || (s.lg is string && s.lg.size() <= 10))
            && (!('s' in s) || (s.s is string && s.s.size() <= 80));
        }
        allow read: if member() && me() in chat().members;
        allow create: if member() && siteOpen() && request.resource.data.from == me()
          && me() in chat().members
          && exists(/databases/$(database)/documents/chatOk/$(me()))
          && request.resource.data.keys().hasOnly(['from', 'text', 'at', 'share'])
          && request.resource.data.text is string && request.resource.data.text.size() <= 500
          && (request.resource.data.text.size() > 0 || 'share' in request.resource.data)
          && (!('share' in request.resource.data) || shareOk(request.resource.data.share))
          && request.resource.data.at == request.time
          && (isGroup(chat()) || (friends(chat().members[0], chat().members[1])
              && !exists(/databases/$(database)/documents/blocks/$(other())/people/$(me()))));
        allow delete: if member() && resource.data.from == me();
      }
    }
    // Reactions (🔥 😂 😮 😭 🐐 👀) on plays, news and moves. reactions/{item} holds the counts anyone can see;
    // reactions/{item}/by/{uid} is your one reaction. Both change together in one write, and the rules check the counts
    // move by exactly your change, so nobody can fake them or react twice.
    function rk() { return ['fire', 'lol', 'wow', 'cry', 'goat', 'eyes']; }
    function cnt(d, k) { return d.get('c', {}).get(k, 0); }
    function oneMove(before, after, had, now, k) {
      return cnt(after, k) == cnt(before, k) + (k == now ? 1 : 0) - (k == had ? 1 : 0);
    }
    function countsOk(before, after, had, now) {
      return had != now && after.keys().hasOnly(['c']) && after.c.keys().hasOnly(rk())
        && oneMove(before, after, had, now, 'fire') && oneMove(before, after, had, now, 'lol') && oneMove(before, after, had, now, 'wow')
        && oneMove(before, after, had, now, 'cry') && oneMove(before, after, had, now, 'goat') && oneMove(before, after, had, now, 'eyes');
    }
    function mineBefore(item) { return exists(/databases/$(database)/documents/reactions/$(item)/by/$(request.auth.uid)) ? get(/databases/$(database)/documents/reactions/$(item)/by/$(request.auth.uid)).data.e : ''; }
    function mineAfter(item) { return existsAfter(/databases/$(database)/documents/reactions/$(item)/by/$(request.auth.uid)) ? getAfter(/databases/$(database)/documents/reactions/$(item)/by/$(request.auth.uid)).data.e : ''; }
    match /reactions/{item} {
      allow get: if true;   // just counts, no names
      allow create, update: if member() && siteOpen() && item.matches('^[A-Za-z0-9_.-]{1,120}$')
        && countsOk(resource == null ? {} : resource.data, request.resource.data, mineBefore(item), mineAfter(item));
      match /by/{uid} {
        allow get: if member() && me() == uid;
        allow create, update: if member() && me() == uid && request.resource.data.keys().hasOnly(['e']) && request.resource.data.e in rk()
          && existsAfter(/databases/$(database)/documents/reactions/$(item))
          && countsOk(exists(/databases/$(database)/documents/reactions/$(item)) ? get(/databases/$(database)/documents/reactions/$(item)).data : {},
                      getAfter(/databases/$(database)/documents/reactions/$(item)).data, mineBefore(item), request.resource.data.e);
        allow delete: if member() && me() == uid
          && countsOk(get(/databases/$(database)/documents/reactions/$(item)).data, getAfter(/databases/$(database)/documents/reactions/$(item)).data, resource.data.e, '');
      }
    }
    // Ideas board: anyone signed in posts an idea (with their username or anonymous) and votes 👍/👎 once per idea.
    // Who wrote an idea is kept in ideaAuthors/{id}, which only the Owner and Mods can read, so "anonymous" stays
    // anonymous to everyone else. Vote counts move only by your own vote (same idea as reactions).
    function votesOk(before, after, had, now) {
      return had != now && after.diff(before).affectedKeys().hasOnly(['up', 'down'])
        && after.up == before.up + (now == 1 ? 1 : 0) - (had == 1 ? 1 : 0)
        && after.down == before.down + (now == -1 ? 1 : 0) - (had == -1 ? 1 : 0);
    }
    function voteBefore(id) { return exists(/databases/$(database)/documents/ideas/$(id)/votes/$(request.auth.uid)) ? get(/databases/$(database)/documents/ideas/$(id)/votes/$(request.auth.uid)).data.v : 0; }
    function voteAfter(id) { return existsAfter(/databases/$(database)/documents/ideas/$(id)/votes/$(request.auth.uid)) ? getAfter(/databases/$(database)/documents/ideas/$(id)/votes/$(request.auth.uid)).data.v : 0; }
    match /ideas/{id} {
      allow read: if member();
      allow create: if member() && siteOpen()
        && request.resource.data.keys().hasOnly(['text', 'name', 'at', 'status', 'up', 'down', 'lg'])
        && request.resource.data.text is string && request.resource.data.text.size() >= 3 && request.resource.data.text.size() <= 300
        && (request.resource.data.name == '' || request.resource.data.name == get(/databases/$(database)/documents/profiles/$(me())).data.username)
        && request.resource.data.status == 'open' && request.resource.data.up == 0 && request.resource.data.down == 0
        && request.resource.data.lg is string && request.resource.data.lg.size() <= 10
        && request.resource.data.at == request.time
        && getAfter(/databases/$(database)/documents/ideaAuthors/$(id)).data.uid == me();
      // Voting.
      allow update: if member() && siteOpen() && votesOk(resource.data, request.resource.data, voteBefore(id), voteAfter(id));
      // Owner and Mods set the status (open / planned / done / not doing).
      allow update: if member() && isMod() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['open', 'planned', 'done', 'no'];
      // The author, the Owner or a Mod can delete it.
      allow delete: if member() && (isMod() || get(/databases/$(database)/documents/ideaAuthors/$(id)).data.uid == me());
      match /votes/{uid} {
        allow get: if member() && me() == uid;
        allow create, update: if member() && siteOpen() && me() == uid && request.resource.data.keys().hasOnly(['v']) && request.resource.data.v in [1, -1]
          && votesOk(get(/databases/$(database)/documents/ideas/$(id)).data, getAfter(/databases/$(database)/documents/ideas/$(id)).data, voteBefore(id), request.resource.data.v);
        allow delete: if member() && me() == uid
          && votesOk(get(/databases/$(database)/documents/ideas/$(id)).data, getAfter(/databases/$(database)/documents/ideas/$(id)).data, resource.data.v, 0);
      }
    }
    match /ideaAuthors/{id} {
      allow get: if member() && (isMod() || resource.data.uid == me());
      allow create: if member() && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid == me()
        && existsAfter(/databases/$(database)/documents/ideas/$(id));
      allow delete: if member() && (isMod() || resource.data.uid == me());
    }
    // Private suggestions (only the Scoreline team reads them): named or anonymous.
    match /suggestions/{id} {
      allow create: if member() && request.resource.data.keys().hasOnly(['text', 'name', 'at'])
        && request.resource.data.text is string && request.resource.data.text.size() >= 3 && request.resource.data.text.size() <= 500
        && (request.resource.data.name == '' || request.resource.data.name == get(/databases/$(database)/documents/profiles/$(me())).data.username)
        && request.resource.data.at == request.time;
      allow read, delete: if member() && roleOf(me()) in ['owner', 'dev', 'mod'];
    }
    // Optional recovery email (username-only accounts): only you can see or change it; the worker emails codes/resets to it.
    match /recovery/{uid} {
      allow get, delete: if signedIn() && me() == uid;
      allow create, update: if signedIn() && me() == uid && request.resource.data.keys().hasOnly(['email', 'at'])
        && request.resource.data.email is string && request.resource.data.email.matches('^[^\s@]+@[^\s@]+\.[^\s@]{2,}$') && request.resource.data.email.size() <= 100
        && request.resource.data.at == request.time;
    }
    // "Forgot password" for username accounts: anyone can ask (signed out); the worker emails a reset link to that
    // account's recovery email if it has one (at most every 15 minutes). Nobody can read these.
    match /resetRequests/{id} {
      allow create: if request.resource.data.keys().hasOnly(['username', 'at'])
        && request.resource.data.username is string && request.resource.data.username.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.at == request.time;
      allow read, update, delete: if false;
    }
    // Agreed to the chat rules (once). Needed before sending messages.
    match /chatOk/{uid} {
      allow get, delete: if member() && me() == uid;
      allow create: if member() && me() == uid && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at == request.time;
    }
    // People you blocked. Only you see your list; they can't message you in a direct chat.
    match /blocks/{uid}/people/{other} {
      allow read, delete: if member() && me() == uid;
      allow create: if member() && me() == uid && other != uid
        && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at == request.time;
    }
    // Reports: anyone signed in can send one; nobody can read them in the app (the owner reviews them).
    match /reports/{id} {
      allow create: if member() && request.resource.data.from == me()   // reports always work, even in read-only
        && request.resource.data.keys().hasOnly(['from', 'about', 'chat', 'text', 'reason', 'at'])
        && request.resource.data.about is string && request.resource.data.about.size() <= 128 && request.resource.data.about != me()
        && request.resource.data.reason in ['bullying', 'inappropriate', 'spam', 'danger', 'other']
        && (!('chat' in request.resource.data) || (request.resource.data.chat is string && request.resource.data.chat.size() <= 64))
        && (!('text' in request.resource.data) || (request.resource.data.text is string && request.resource.data.text.size() <= 500))
        && request.resource.data.at == request.time;
      allow read: if member() && isMod();   // the Owner and Mods review reports in Dev tools
      allow update, delete: if false;
    }
  }
}
