{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scoreline Setup",
  "version": "1.0.0",
  "identifier": "io.github.cadensauce.scoreline.setup",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Scoreline Setup",
        "width": 520,
        "height": 320,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "shadow": true,
        "center": true,
        "backgroundColor": "#101012"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
